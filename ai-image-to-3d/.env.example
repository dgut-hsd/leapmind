# Application
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
DATA_DIR=/app/data
DATABASE_URL=sqlite:////app/data/app.db

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# OpenAI Image API
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=3

# 3D provider: mock or meshy
THREE_D_PROVIDER=mock
MESHY_API_KEY=
MESHY_BASE_URL=https://api.meshy.ai
MESHY_TIMEOUT_SECONDS=60
MESHY_POLL_INTERVAL_SECONDS=10
MESHY_MAX_WAIT_SECONDS=1800

# Upload / preprocessing
MAX_UPLOAD_BYTES=10485760
IMAGE_TARGET_SIZE=1024
REMOVE_BACKGROUND=true

# Blender
BLENDER_EXECUTABLE=blender
BLENDER_TIMEOUT_SECONDS=900
BLENDER_MIN_FRAGMENT_RATIO=0.001
BLENDER_DECIMATE_FACE_COUNT=0
BLENDER_TRIANGULATE=false

